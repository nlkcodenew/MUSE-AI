<?xml version="1.0" encoding="UTF-8"?>
<!-- Theme rieng cho he dreamcast: ke thua theme goc roi them anh chim
     (watermark) dai dien cho he nay vao man chon he. Cac he khong co
     file rieng se dung man chon he mac dinh (nen aurora, khong watermark). -->
<theme>
  <formatVersion>7</formatVersion>
  <include>./../theme.xml</include>
  <view name="system">
    <image name="sysWatermark" extra="true">
      <origin>0 0</origin>
      <pos>0 0</pos>
      <size>1 1</size>
      <path>./../art/sys/dreamcast.png</path>
      <zIndex>2</zIndex>
    </image>
  </view>
</theme>
